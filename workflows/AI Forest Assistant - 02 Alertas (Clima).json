            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "id": "REPLACE_NODE_ID_cada-4-horas",
      "name": "Cada 4 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -1296,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const weather = $input.first().json;\n\n// Extraer datos\nconst temp = weather.main?.temp || 0;\nconst humidity = weather.main?.humidity || 0;\nconst windSpeed = weather.wind?.speed * 3.6 || 0; // convertir m/s a km/h\nconst zoneName = weather.name || 'Zona Forestal';\nconst timestamp = new Date().toISOString();\n\n// Calcular riesgo\nlet riskScore = 0;\nlet riskLevel = 'BAJO';\n\n// Temperatura (>30°C = riesgo)\nif (temp > 35) riskScore += 40;\nelse if (temp > 30) riskScore += 30;\nelse if (temp > 25) riskScore += 15;\n\n// Humedad (<30% = riesgo)\nif (humidity < 20) riskScore += 40;\nelse if (humidity < 30) riskScore += 30;\nelse if (humidity < 40) riskScore += 15;\n\n// Viento (>30 km/h = riesgo)\nif (windSpeed > 50) riskScore += 30;\nelse if (windSpeed > 30) riskScore += 20;\nelse if (windSpeed > 20) riskScore += 10;\n\n// Determinar nivel\nif (riskScore >= 70) riskLevel = 'EXTREMO';\nelse if (riskScore >= 50) riskLevel = 'ALTO';\nelse if (riskScore >= 30) riskLevel = 'MODERADO';\nelse riskLevel = 'BAJO';\n\nconst requiresAlert = riskLevel === 'ALTO' || riskLevel === 'EXTREMO';\n\nreturn [{\n  json: {\n    temperature: temp,\n    humidity: humidity,\n    wind_speed: windSpeed,\n    zone_name: zoneName,\n\n    // ambos nombres\n    risk_level: riskLevel,\n    fire_risk: riskLevel,\n\n    risk_score: riskScore,\n    requires_alert: requiresAlert,\n    timestamp: timestamp,\n    full_data: 'SANITIZED_FOR_GITHUB'\n  }\n}];"
      },
      "id": "REPLACE_NODE_ID_calcular-riesgo",
      "name": "Calcular Riesgo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "alert-check",
              "leftValue": "={{ $json.fire_risk === \"ALTO\" || $json.fire_risk === \"EXTREMO\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "REPLACE_NODE_ID_riesgo-alto-o-extremo",
      "name": "¿Riesgo Alto o Extremo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -224,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const risk = $input.first().json;\n\nconst rawBrigadistas = $env.BRIGADISTAS_WHATSAPP || '[]';\n\nlet brigadistas;\ntry {\n  brigadistas = JSON.parse(rawBrigadistas);\n} catch (error) {\n  throw new Error('BRIGADISTAS_WHATSAPP no es JSON válido.');\n}\n\nif (!Array.isArray(brigadistas) || brigadistas.length === 0) {\n  throw new Error('No hay brigadistas configurados.');\n}\n\nconst riskEmoji = {\n  EXTREMO: '🔴🔴🔴',\n  ALTO: '🟠🟠'\n}[risk.risk_level] || '⚠️';\n\nconst mensaje = `${riskEmoji} *ALERTA FORESTAL* ${riskEmoji}\\n\\n` +\n  `📍 *Zona:* ${risk.zone_name || 'No especificada'}\\n` +\n  `🔥 *Riesgo:* ${risk.risk_level || 'No especificado'} (${risk.risk_score || 0} pts)\\n` +\n  `━━━━━━━━━━━━━━━━━━━━\\n` +\n  `🌡️ *Temperatura:* ${risk.temperature || 'N/D'}°C\\n` +\n  `💧 *Humedad:* ${risk.humidity || 'N/D'}%\\n` +\n  `💨 *Viento:* ${Math.round(Number(risk.wind_speed || 0))} km/h\\n` +\n  `━━━━━━━━━━━━━━━━━━━━\\n` +\n  `⚠️ *Recomendación:*\\n` +\n  `• Extremar precaución\\n` +\n  `• Prohibir quemas\\n` +\n  `• Activar vigilancia\\n\\n` +\n  `📅 ${risk.timestamp ? new Date(risk.timestamp).toLocaleString('es-ES') : new Date().toLocaleString('es-ES')}`;\n\nreturn brigadistas.map(telefono => ({\n  json: {\n    to: String(telefono).replace(/\\D/g, ''),\n    message: mensaje,\n    risk_data: risk\n  }\n}));"
      },
      "id": "REPLACE_NODE_ID_preparar-mensajes-brigadistas",
      "name": "Preparar Mensajes Brigadistas",
