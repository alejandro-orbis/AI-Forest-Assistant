      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Guardar en fire_alerts\nconst alertRecord = {\n  table: 'fire_alerts',\n  payload: {\n    zone_name: input.zone_name,\n    temperature: input.temperature,\n    humidity: input.humidity,\n    wind_speed: input.wind_speed,\n    fire_risk: input.risk_level,\n    alert_sent: input.requires_alert || false,\n    requires_alert: input.requires_alert || false,\n    metadata: {\n      risk_score: input.risk_score,\n      raw_data: 'SANITIZED_FOR_GITHUB',\n      triggered_at: input.timestamp\n    }\n  }\n};\n\nreturn [{ json: alertRecord }];"
      },
