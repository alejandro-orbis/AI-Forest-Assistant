        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  messaging_product: \"whatsapp\",\n  recipient_type: \"individual\",\n  to: String($json.to || \"\"),\n  type: \"text\",\n  text: {\n    preview_url: false,\n    body: String($json.message || \"🚨 Alerta forestal\")\n  }\n}) }}",
        "options": {
          "timeout": 30000
        }
      },
