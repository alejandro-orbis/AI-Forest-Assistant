# ============================================
# AI FOREST ASSISTANT
# Environment Variables Example
# ============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Completa los valores con tus credenciales reales
# 3. Nunca subas .env al repositorio (está en .gitignore)
#
# ============================================
# N8N
# ============================================

N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ============================================
# GEMINI AI
# ============================================

GEMINI_API_KEY=

# ============================================
# META / WHATSAPP BUSINESS API
# ============================================

META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ============================================
# GOOGLE MAPS
# ============================================

GOOGLE_MAPS_API_KEY=

# ============================================
# OPENWEATHERMAP
# ============================================

OPENWEATHER_API_KEY=

# ============================================
# SUPERVISOR / ALERTS
# ============================================

SUPERVISOR_WHATSAPP=
SUPERVISOR_EMAIL=

# ============================================
# BRIGADISTAS / EMERGENCY ALERTS
# ============================================

BRIGADISTAS_WHATSAPP=
BRIGADISTAS_EMAILS=

# Activar envío masivo
ENABLE_BRIGADISTA_ALERTS=true

# Lista separada por comas
# Ejemplo: BRIGADISTAS_WHATSAPP=34611111111,34622222222
BRIGADISTAS_WHATSAPP=

# ============================================
# RATE LIMIT
# ============================================

RATE_LIMIT_PER_MINUTE=15